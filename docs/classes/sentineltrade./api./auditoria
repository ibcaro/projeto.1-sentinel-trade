from typing import List, Optional

from fastapi import APIRouter, Depends, Query

from .contexto import Contexto
from ..dominio.entidades import Administrador
from ..servicos.auditoria import FiltroLog
from .dependencias import administrador_atual, obter_contexto
from .schemas import LogResposta

router = APIRouter(prefix="/auditoria", tags=["auditoria"])


@router.get("/logs", response_model=List[LogResposta])
def consultar_logs(
    inicio: Optional[str] = Query(None, max_length=40),
    fim: Optional[str] = Query(None, max_length=40),
    usuario: Optional[str] = Query(None, max_length=64),
    id_ordem: Optional[int] = Query(None, gt=0),
    limite: int = Query(100, ge=1, le=200),
    administrador: Administrador = Depends(administrador_atual),
    contexto: Contexto = Depends(obter_contexto),
):
    filtro = FiltroLog(inicio, fim, usuario, id_ordem, limite)
    registros = contexto.auditoria.consultar_como_administrador(administrador, filtro)
    return [LogResposta(**r.__dict__) for r in registros]
