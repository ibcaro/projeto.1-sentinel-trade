"""Apoio aos testes: monta um sistema completo em memória (banco SQLite em memória)."""
import sys
from decimal import Decimal
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from sentineltrade.api.contexto import criar_contexto  # noqa: E402
from sentineltrade.dominio import seguranca  # noqa: E402
from sentineltrade.dominio.entidades import (  # noqa: E402
    Administrador,
    Ativo,
    Carteira,
    Conta,
    Investidor,
    LimiteRisco,
)
from sentineltrade.dominio.estados import TipoOrdem  # noqa: E402
from sentineltrade.integracoes.bolsa import BolsaSimulada  # noqa: E402
from sentineltrade.servicos.ordem import DadosOrdem  # noqa: E402

CHAVE = "k" * 40
SENHA = "senha-forte-123"


class Relogio:
    def __init__(self):
        self.agora = 1_700_000_000.0

    def __call__(self):
        return self.agora

    def avancar(self, segundos):
        self.agora += segundos


def criar_ambiente(bolsa=None):
    relogio = Relogio()
    ctx = criar_contexto(
        chave_token=CHAVE, bolsa=bolsa or BolsaSimulada(), relogio=relogio, dormir=lambda s: None
    )
    ctx.ativos.salvar(Ativo("PETR4", "Petrobras PN", Decimal("30.00"), True))
    ctx.ativos.salvar(Ativo("VALE3", "Vale ON", Decimal("60.00"), True))
    ctx.ativos.salvar(Ativo("MGLU3", "Magazine Luiza ON", Decimal("10.00"), False))
    return ctx, relogio


def criar_investidor(ctx, email="inv@teste.com", saldo="10000.00", limite="5000.00", posicoes=None):
    segredo = seguranca.gerar_segredo_mfa()
    investidor = Investidor(
        None,
        email,
        seguranca.gerar_hash_senha(SENHA),
        segredo,
        conta=Conta(Decimal(saldo)),
        carteira=Carteira(posicoes or {}),
        limite=LimiteRisco(Decimal(limite)),
    )
    ctx.usuarios.salvar(investidor)
    return investidor, segredo


def criar_administrador(ctx, email="admin@teste.com"):
    segredo = seguranca.gerar_segredo_mfa()
    admin = Administrador(None, email, seguranca.gerar_hash_senha(SENHA), segredo)
    ctx.usuarios.salvar(admin)
    return admin, segredo


def dados(ativo="PETR4", tipo=TipoOrdem.COMPRA, quantidade=100, preco="30.00", chave="chave-0001"):
    return DadosOrdem(ativo, tipo, quantidade, Decimal(preco), chave)


def acoes_do_log(ctx):
    return [r.acao for r in ctx.logs.todos()]
